# Copy to .env.production, chmod 600. Do not publish until owner/provider acceptance.
SITE_DOMAIN=learn.example.ru
APP_URL=https://learn.example.ru
NODE_ENV=production
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
# URL-encode special characters in the database password.
DATABASE_URL=postgresql://app:REPLACE_WITH_RANDOM_PASSWORD@postgres:5432/dental
TRUST_PROXY=true
SITE_INDEXING=false
ADMIN_EMAILS=
SUPPORT_EMAIL=
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_INN=
LEGAL_ENTITY_OGRN=
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_CHAT_MODEL=
LLM_EMBEDDING_MODEL=
LLM_EMBEDDING_BASE_URL=
LLM_EMBEDDING_API_KEY=
EMBEDDING_DIM=1536
LLM_TEMPERATURE=0.2
LLM_DAILY_BUDGET_RUB=1000
PAYMENTS_PROVIDER=yookassa
YOOKASSA_TEST_MODE=true
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_IPS=
RECEIPT_VAT_CODE=
RECEIPT_TAX_SYSTEM_CODE=
MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
STORAGE_DRIVER=s3
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Separate private backup bucket on the same provider; apply 14-day lifecycle.
BACKUP_S3_ENDPOINT=https://storage.yandexcloud.net
BACKUP_S3_REGION=ru-central1
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
SENTRY_DSN=
YANDEX_METRIKA_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
