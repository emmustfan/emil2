# Приложение
APP_URL=http://localhost:3000
BRAND_NAME="Рабочее название"
# Реальная почта поддержки; оставьте пустым до подключения.
SUPPORT_EMAIL=
ADMIN_EMAILS=owner@example.ru
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_INN=
LEGAL_ENTITY_OGRN=

# База данных
DATABASE_URL=postgresql://app:app@localhost:5432/app

# Почта (в dev — Mailpit: localhost:1025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_TRANSPORT=log   # smtp для Mailpit, log для тестов и Codex cloud
MAIL_FROM="Рабочее название <no-reply@example.ru>"

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ЮKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Список IP/CIDR из документации ЮKassa, через запятую.
YOOKASSA_WEBHOOK_IPS=
# Код НДС уточнить у бухгалтера по режиму налогообложения.
RECEIPT_VAT_CODE=
PAYMENTS_PROVIDER=mock   # yookassa для подключённого магазина; mock для локальной проверки

# LLM
# Обычный start-mac.command сохраняет mock. Для явного подключения см. docs/integrations.md.
LLM_PROVIDER=mock   # openai_compatible, anthropic; mock для тестов и локального просмотра
LLM_BASE_URL=
LLM_API_KEY=
LLM_CHAT_MODEL=
LLM_TEMPERATURE=0.2
LLM_EMBEDDING_MODEL=
# Для Anthropic эмбеддинги запрашиваются отдельно через OpenAI-совместимый сервис.
LLM_EMBEDDING_BASE_URL=
LLM_EMBEDDING_API_KEY=
EMBEDDING_DIM=1536
LLM_DAILY_BUDGET_RUB=1000

# Хранилище (в dev — MinIO)
STORAGE_DRIVER=local   # или local (тесты, Codex cloud)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-central1
S3_BUCKET=uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Аналитика и мониторинг
YANDEX_METRIKA_ID=
SENTRY_DSN=

# true only behind a trusted proxy which replaces X-Real-IP
TRUST_PROXY=false
# Яндекс.Метрика необязательна: заполните YANDEX_METRIKA_ID выше числовым ID.
# Без ID внешние запросы и баннер не создаются. Webvisor выключен.

# Платежи: тестовый магазин по умолчанию. Боевые списания требуют отдельной настройки.
YOOKASSA_TEST_MODE=true
# RECEIPT_VAT_CODE и YOOKASSA_WEBHOOK_IPS заполните выше для подключения ЮKassa.
# Дополнительно: код системы налогообложения, если требуется настройками магазина (1–6).
RECEIPT_TAX_SYSTEM_CODE=
