# Приложение
APP_URL=http://localhost:3000
BRAND_NAME="Рабочее название"
SUPPORT_EMAIL=support@example.ru
ADMIN_EMAILS=owner@example.ru
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_INN=
LEGAL_ENTITY_OGRN=

# База данных
DATABASE_URL=postgresql://app:app@localhost:5432/app

# Почта (в dev — Mailpit: localhost:1025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_TRANSPORT=log   # smtp для Mailpit, log для тестов и Codex cloud
MAIL_FROM="Рабочее название <no-reply@example.ru>"

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ЮKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_IPS=   # список из документации ЮKassa, через запятую
RECEIPT_VAT_CODE=       # уточнить у бухгалтера по режиму налогообложения
PAYMENTS_PROVIDER=mock   # или mock (тесты, Codex cloud)

# LLM
LLM_PROVIDER=mock   # openai_compatible, anthropic; mock для тестов и локального просмотра
LLM_BASE_URL=
LLM_API_KEY=
LLM_CHAT_MODEL=
LLM_TEMPERATURE=0.2
LLM_EMBEDDING_MODEL=
# Для Anthropic эмбеддинги запрашиваются отдельно через OpenAI-совместимый сервис.
LLM_EMBEDDING_BASE_URL=
LLM_EMBEDDING_API_KEY=
EMBEDDING_DIM=1536
LLM_DAILY_BUDGET_RUB=1000

# Хранилище (в dev — MinIO)
STORAGE_DRIVER=local   # или local (тесты, Codex cloud)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-central1
S3_BUCKET=uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Аналитика и мониторинг
YANDEX_METRIKA_ID=
SENTRY_DSN=

# true only behind a trusted proxy which replaces X-Real-IP
TRUST_PROXY=false
